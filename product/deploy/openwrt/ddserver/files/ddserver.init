#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/ddserver
ENV_FILE=/etc/d810-ddserver.env

start_service() {
	[ -r "$ENV_FILE" ] && . "$ENV_FILE"
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env \
		DDSERVER_BULK_READ_SIZE="${DDSERVER_BULK_READ_SIZE:-32768}" \
		DDSERVER_TRACE_USB="${DDSERVER_TRACE_USB:-0}"
  # retry=-1 keeps the camera bridge recoverable after repeated field faults;
  # procd's default finite retry budget can otherwise leave it stopped.
  procd_set_param respawn 3600 5 -1
	procd_close_instance
}
