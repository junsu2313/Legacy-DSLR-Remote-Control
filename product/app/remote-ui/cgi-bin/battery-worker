#!/bin/sh
PATH=/usr/bin:/bin:/usr/sbin:/sbin

SCRIPT_DIR=$(dirname "$0")
case "$SCRIPT_DIR" in
  /*) ;;
  *) SCRIPT_DIR=/www/cgi-bin ;;
esac
. "$SCRIPT_DIR/bridge-common.sh"

BATTERY_WORKER_PIDFILE=${D810D_BATTERY_WORKER_PIDFILE:-/tmp/d810-battery-worker.pid}
BATTERY_WORKER_LOCKDIR=${D810D_BATTERY_WORKER_LOCKDIR:-/tmp/d810-battery-worker.lock}
BATTERY_CACHE_PATH=${D810D_BATTERY_CACHE:-/tmp/d810-battery.cache}
BATTERY_CACHE_TS_PATH=${D810D_BATTERY_CACHE_TS:-/tmp/d810-battery.cache.ts}
SESSION_STATE=${D810D_SESSION_STATE:-/tmp/d810-session.state}
COMMAND_LOCK=${D810D_COMMAND_ACTION_LOCK:-/tmp/d810-command.lock}
FRAME_LOCK=${D810D_FRAME_CAPTURE_LOCK:-/tmp/d810-live.lock}
BATTERY_POLL_SEC=${D810D_BATTERY_POLL_SEC:-30}
# Battery is a coarse, low-frequency observation.  Do not refresh it every
# status request; take one fresh camera reading at most once per 10 minutes.
BATTERY_REFRESH_SEC=${D810D_BATTERY_REFRESH_SEC:-600}

clear_stale_worker_lock() {
  [ -d "$BATTERY_WORKER_LOCKDIR" ] || return 0
  lock_pid=$(cat "$BATTERY_WORKER_LOCKDIR/pid" 2>/dev/null || true)
  case "$lock_pid" in
    ''|*[!0-9]*)
      rm -f "$BATTERY_WORKER_LOCKDIR/pid" 2>/dev/null || true
      rmdir "$BATTERY_WORKER_LOCKDIR" 2>/dev/null || true
      return 0
      ;;
  esac
  if kill -0 "$lock_pid" 2>/dev/null; then
    return 1
  fi
  rm -f "$BATTERY_WORKER_LOCKDIR/pid" 2>/dev/null || true
  rmdir "$BATTERY_WORKER_LOCKDIR" 2>/dev/null || true
  return 0
}

acquire_worker_lock() {
  if mkdir "$BATTERY_WORKER_LOCKDIR" 2>/dev/null; then
    printf '%s\n' "$$" > "$BATTERY_WORKER_LOCKDIR/pid"
    return 0
  fi
  clear_stale_worker_lock || return 1
  if mkdir "$BATTERY_WORKER_LOCKDIR" 2>/dev/null; then
    printf '%s\n' "$$" > "$BATTERY_WORKER_LOCKDIR/pid"
    return 0
  fi
  return 1
}

acquire_worker_lock || exit 0
printf '%s\n' "$$" > "$BATTERY_WORKER_PIDFILE"
trap 'rm -f "$BATTERY_WORKER_PIDFILE"; rm -f "$BATTERY_WORKER_LOCKDIR/pid"; rmdir "$BATTERY_WORKER_LOCKDIR" 2>/dev/null || true' EXIT INT TERM

read_state_field() {
  key=$1
  [ -r "$SESSION_STATE" ] || return 1
  awk -F= -v k="$key" '$1==k {print substr($0, index($0, "=")+1); exit}' "$SESSION_STATE"
}

is_idle_window() {
  [ ! -d "$COMMAND_LOCK" ] || return 1
  [ ! -d "$FRAME_LOCK" ] || return 1

  live_view=$(read_state_field liveView 2>/dev/null || true)
  [ "$live_view" = "true" ] && return 1

  hardware_detected=$(read_state_field hardwareDetected 2>/dev/null || true)
  [ "$hardware_detected" = "true" ] || return 1

  return 0
}

read_battery_percent() {
  bridge_alive || return 1
  output=$(bridge_request_timed BATTERY_STATUS 5 2>/dev/null || true)
  percent=$(printf '%s\n' "$output" | grep -Eo '"batteryPercent":[0-9]+' | head -n 1 | tr -cd '0-9')
  case "$percent" in
    ''|*[!0-9]*)
      return 1
      ;;
  esac
  printf '%s\n' "$percent"
}

write_cache() {
  value=$1
  case "$value" in
    ''|*[!0-9]*)
      return 1
      ;;
  esac
  if [ "$value" -lt 0 ]; then
    value=0
  fi
  if [ "$value" -gt 100 ]; then
    value=100
  fi
  printf '%s' "$value" > "$BATTERY_CACHE_PATH"
  date +%s > "$BATTERY_CACHE_TS_PATH"
}

cache_is_fresh() {
  [ -r "$BATTERY_CACHE_TS_PATH" ] || return 1
  stamp=$(cat "$BATTERY_CACHE_TS_PATH" 2>/dev/null || true)
  case "$stamp" in
    ''|*[!0-9]*)
      return 1
      ;;
  esac
  now=$(date +%s)
  age=$((now - stamp))
  [ "$age" -lt "$BATTERY_REFRESH_SEC" ]
}

while true; do
  if is_idle_window && ! cache_is_fresh; then
    value=$(read_battery_percent 2>/dev/null || true)
    if [ -n "$value" ]; then
      write_cache "$value" || true
    else
      # Never leave an old value looking like a current battery reading.
      rm -f "$BATTERY_CACHE_PATH" "$BATTERY_CACHE_TS_PATH"
    fi
  fi
  sleep "$BATTERY_POLL_SEC"
done
