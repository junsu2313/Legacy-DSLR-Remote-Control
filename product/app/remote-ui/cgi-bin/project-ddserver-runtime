#!/bin/sh
PATH=/usr/bin:/bin:/usr/sbin:/sbin

SCRIPT_DIR=$(dirname "$0")
case "$SCRIPT_DIR" in
  /*) ;;
  *) SCRIPT_DIR=/www/cgi-bin ;;
esac
. "$SCRIPT_DIR/variant-v21-env.sh"
. "$SCRIPT_DIR/bridge-common.sh"

case "${1:-status}" in
  start) project_ddserver_start ;;
  stop) project_ddserver_stop ;;
  restart) project_ddserver_restart ;;
  status) project_ddserver_ready ;;
  *) exit 2 ;;
esac
