#!/bin/sh
PATH=/usr/bin:/bin:/usr/sbin:/sbin
SCRIPT_DIR=$(dirname "$0")
. "$SCRIPT_DIR/bridge-common.sh"

SESSION_HEALTH_PIDFILE=${D810D_SESSION_HEALTH_PIDFILE:-/tmp/d810-session-health.pid}
INTERVAL=${D810D_SESSION_HEALTH_INTERVAL:-1}
printf '%s\n' "$$" > "$SESSION_HEALTH_PIDFILE"
trap 'rm -f "$SESSION_HEALTH_PIDFILE"' EXIT INT TERM

if bridge_alive; then
  bridge_request STATUS >/dev/null 2>&1 || true
  bridge_request MAINTAIN >/dev/null 2>&1 || true
fi
